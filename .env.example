# Copy to .env and fill in. Both values are public (safe inside the app).
# Supabase dashboard > Project Settings > API (URL) and API Keys (publishable key).
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Secrets do NOT go here. They are set in Supabase > Edge Functions > Secrets:
#   GEMINI_API_KEY   (required for AI analysis)
#   GEMINI_MODEL     (optional, comma-separated list of model ids to try in order)
